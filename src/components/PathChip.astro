---
// A tiny window title bar with the page name: the one quiet cue used on inner pages.
import { site } from '../config/site';
interface Props { path: string }
const { path } = Astro.props;
---
{site.features.softwareCues && (
  <div class="chip reveal" aria-hidden="true" style="--i:0">
    <span class="chip__dots"><i></i><i></i><i></i></span>
    <span class="chip__path">{path}</span>
  </div>
)}

<style is:global>
  .chip { display: inline-flex; align-items: center; gap: .7rem; margin-bottom: 1rem; padding: .3rem .8rem .3rem .55rem; background: var(--cream); border: solid var(--brown); border-width: 1.5px 3px 2.5px 1.5px; font-size: .8rem; line-height: 1; } /* uneven sides: the line swells and thins */
  .chip__dots { display: inline-flex; gap: .3rem; }
  .chip__dots i { display: block; width: .6rem; height: .6rem; border: solid var(--brown); border-width: 1.5px 2.5px 2px 1.5px; }
  .chip__dots i:nth-child(1) { background: var(--coral); } .chip__dots i:nth-child(2) { background: var(--mustard); } .chip__dots i:nth-child(3) { background: var(--brown); }
</style>
