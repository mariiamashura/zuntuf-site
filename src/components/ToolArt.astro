---
// A tool's interactive illustration. The picture stays whole. It tilts a little with the pointer, its spirals keep turning,
// and square sheets slide out of the folder one after another. See src/lib/art.ts.
import { ART, polygon, circle } from '../lib/art';
import { inkOutline } from '../lib/wheel';
interface Props { slug: string; art: string; alt?: string }
const { slug, art, alt = '' } = Astro.props;
const cfg = ART[art];
const src = `/tools/${slug}/art.webp`;
const FILL = { mustard: '#E8AA20', coral: '#F05249', cream: '#F5EED8', ochre: '#96601F' } as const;
const SQ: [number, number][] = [[4, 4], [96, 4], [96, 96], [4, 96]];
const pct = (n: number) => `${((n / 1024) * 100).toFixed(3)}%`;
const SIZE = 168; // sheet size in picture pixels
---
{cfg && (
  <div class={`tart${cfg.alive ? ' tart--alive' : ''}${cfg.strain ? ' tart--strain' : ''}`} data-tart aria-hidden={alt ? undefined : 'true'} role={alt ? 'img' : undefined} aria-label={alt || undefined}>
    <div class="tart__tilt">
      {cfg.sheetsBehind && (<>
      {(cfg.sheets ?? []).map((s, i) => (
        <div class="tart__sheet" style={`left:${pct(s.x - SIZE / 2)};top:${pct(s.y)};width:${pct(SIZE)};--dx:${s.dx * 100}%;--dy:${s.dy * 100}%;--r:${s.r}deg;--i:${i}`}>
          <svg viewBox="0 0 100 100" focusable="false">
            <polygon points={inkOutline(SQ, 20 + i, 1.2, 3.6)} fill="#512B19" />
            <polygon points={SQ.map((q) => q.join(',')).join(' ')} fill={FILL[s.fill]} />
            {Array.from({ length: s.lines ?? 0 }, (_, k) => (
              <rect x="20" y={28 + k * 17} width={k % 2 ? 44 : 60} height="7" fill="#512B19" />
            ))}
            {s.icon === 'sun' && (<g>
              {Array.from({ length: 8 }, (_, k) => (<polygon points="47,12 53,12 51,27 49,27" fill="#512B19" transform={`rotate(${k * 45} 50 50)`} />))}
              <circle cx="50" cy="50" r="17" fill="#F5C42A" stroke="#512B19" stroke-width="3.2" />
            </g>)}
            {s.icon === 'star' && (<polygon points="50,15 59,39 85,40 64,56 72,82 50,67 28,82 36,56 15,40 41,39" fill={s.fill === 'coral' ? '#F5C42A' : '#F05249'} stroke="#512B19" stroke-width="3.2" stroke-linejoin="miter" />)}
            {s.icon === 'smile' && (<g>
              <circle cx="50" cy="50" r="28" fill={s.fill === 'coral' ? '#F5C42A' : '#E8AA20'} stroke="#512B19" stroke-width="3.2" />
              <circle cx="41" cy="43" r="3.6" fill="#512B19" /><circle cx="59" cy="43" r="3.6" fill="#512B19" />
              <path d="M36 56 Q50 71 64 56" fill="none" stroke="#512B19" stroke-width="3.6" stroke-linecap="round" />
            </g>)}
          </svg>
        </div>
      ))}

      </>)}
      <img class="tart__base" src={src} alt="" loading="lazy" decoding="async" draggable="false" />

      {!cfg.sheetsBehind && (<>
      {(cfg.sheets ?? []).map((s, i) => (
        <div class="tart__sheet" style={`left:${pct(s.x - SIZE / 2)};top:${pct(s.y)};width:${pct(SIZE)};--dx:${s.dx * 100}%;--dy:${s.dy * 100}%;--r:${s.r}deg;--i:${i}`}>
          <svg viewBox="0 0 100 100" focusable="false">
            <polygon points={inkOutline(SQ, 20 + i, 1.2, 3.6)} fill="#512B19" />
            <polygon points={SQ.map((q) => q.join(',')).join(' ')} fill={FILL[s.fill]} />
            {Array.from({ length: s.lines ?? 0 }, (_, k) => (
              <rect x="20" y={28 + k * 17} width={k % 2 ? 44 : 60} height="7" fill="#512B19" />
            ))}
          </svg>
        </div>
      ))}

      </>)}

      {(cfg.echoes ?? []).map((e, i) => (
        <div class="tart__echo" style={`clip-path:${polygon(e.poly)};--dx:${(e.dx / 1024) * 100}%;--dy:${(e.dy / 1024) * 100}%;--sc:${e.scale ?? 1};--er:${e.rot ?? 0}deg;--d:${e.delay ?? i}s;--t:${e.dur ?? 4}s`}>
          <img src={src} alt="" loading="lazy" decoding="async" draggable="false" />
        </div>
      ))}

      <!-- the folder's front, drawn again exactly over the same pixels so the sheets come out from behind it -->
      <div class="tart__front" style={`clip-path:${polygon(cfg.front ?? [[0, 0], [1024, 0], [1024, 1024], [0, 1024]])}`}>
        <img src={src} alt="" loading="lazy" decoding="async" draggable="false" />
        {(cfg.eyes ?? []).map((e) => (
          <div class="tart__eye" style={`clip-path:${circle(e.x, e.y, e.r)};transform-origin:${((e.x / 1024) * 100).toFixed(3)}% ${((e.y / 1024) * 100).toFixed(3)}%;--dur:${e.dur}s;--dir:${e.reverse ? 'reverse' : 'normal'}`}>
            <img src={src} alt="" loading="lazy" decoding="async" draggable="false" />
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<style is:global>
  .tart { position: relative; width: 100%; aspect-ratio: 1; perspective: 1100px; }
  .tart__tilt { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); }
  .tart img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; user-select: none; -webkit-user-drag: none; pointer-events: none; }
  .tart__front { position: absolute; inset: 0; }
  .tart__eye { position: absolute; inset: 0; }
  .tart__echo { position: absolute; inset: 0; opacity: 0; pointer-events: none; }

  /* sheets: each starts hidden behind the front panel, climbs out, tilts, drifts on and fades; they take turns */
  .tart__sheet { position: absolute; aspect-ratio: 1; opacity: 0; pointer-events: none; will-change: transform, opacity; }
  .tart__sheet svg { display: block; width: 100%; height: 100%; overflow: visible; }
  @media (prefers-reduced-motion: no-preference) {
    .tart__sheet { animation: tart-sheet 11s cubic-bezier(.35, .1, .3, 1) infinite; animation-delay: calc(var(--i) * 2.2s); }
    .tart__echo { animation: tart-echo var(--t, 4s) ease-out infinite; animation-delay: var(--d, 0s); }
    .tart__eye { animation: tart-spin var(--dur, 24s) linear infinite var(--dir, normal); }
    .tart.is-spin .tart__eye { animation-duration: 2.4s; }
  }
  /* reduced motion: one sheet rests half out of the folder, nothing moves */
  @media (prefers-reduced-motion: reduce) { .tart__sheet:first-of-type { opacity: 1; transform: translate(0, -110%) rotate(5deg); } }
  @keyframes tart-sheet {
    0%   { opacity: 0; transform: translate(0, 0) rotate(0deg); }
    3%   { opacity: 1; transform: translate(0, 0) rotate(0deg); }
    14%  { transform: translate(0, 0) rotate(0deg); }
    58%  { opacity: 1; transform: translate(calc(var(--dx) * .8), calc(var(--dy) * .8)) rotate(calc(var(--r) * .8)); }
    80%  { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--r)); }
    100% { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--r)); }
  }
  @keyframes tart-echo { 0% { opacity: 0; transform: translate(0, 0) scale(1) rotate(0deg); } 10% { opacity: .9; } 70% { opacity: .35; } 100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(var(--sc, 1)) rotate(var(--er, 0deg)); } }
  /* alive: the whole picture breathes and sways a little (individual transform properties, GPU only) */
  @media (prefers-reduced-motion: no-preference) {
    .tart--alive { animation: tart-breathe 6.5s ease-in-out infinite, tart-sway 9s ease-in-out infinite; transform-origin: 50% 60%; }
  }
  /* strain: it trembles, then lunges, as if trying to break free */
  @media (prefers-reduced-motion: no-preference) {
    .tart--strain { animation: tart-strain 6.5s linear infinite; transform-origin: 50% 62%; }
    .tart--strain .tart__tilt { animation: tart-jitter .22s steps(2, jump-none) infinite; }
  }
  @keyframes tart-jitter { 0% { translate: -.1% .05%; } 100% { translate: .1% -.06%; } }
  @keyframes tart-strain {
    0%, 100% { translate: 0 0; rotate: 0deg; scale: 1; animation-timing-function: ease-out; }
    5% { translate: -.45% .15%; rotate: -1deg; scale: 1.012; animation-timing-function: ease-in-out; }
    9% { translate: .5% -.2%; rotate: 1.1deg; scale: .994; animation-timing-function: ease-in-out; }
    13% { translate: -.3% .12%; rotate: -.7deg; scale: 1.01; animation-timing-function: ease-in-out; }
    18% { translate: .22% -.1%; rotate: .5deg; scale: 1; animation-timing-function: ease-out; }
    26% { translate: 0 0; rotate: 0deg; scale: 1; animation-timing-function: ease-in; }
    52% { translate: 0 0; rotate: 0deg; scale: 1; animation-timing-function: ease-in-out; }
    56% { translate: 0 .6%; rotate: 0deg; scale: .982; animation-timing-function: cubic-bezier(.2, 1.4, .4, 1); }
    62% { translate: .6% -1.4%; rotate: 1.8deg; scale: 1.032; animation-timing-function: ease-out; }
    70% { translate: -.35% -.5%; rotate: -1deg; scale: 1.008; animation-timing-function: ease-in-out; }
    78% { translate: .15% -.1%; rotate: .4deg; scale: 1; animation-timing-function: ease-out; }
    88% { translate: 0 0; rotate: 0deg; scale: 1; }
  }
  @keyframes tart-breathe { 0%, 100% { scale: 1; translate: 0 0; } 50% { scale: 1.035; translate: 0 -1.2%; } }
  @keyframes tart-sway { 0%, 100% { rotate: -1.8deg; } 50% { rotate: 1.8deg; } }
  @keyframes tart-spin { to { rotate: 360deg; } }
</style>

<script>
  import '../scripts/tart';
</script>
