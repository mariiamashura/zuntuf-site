---
import { buildRays, hubDiscs, CENTER, R_START, type WheelItem } from '../lib/wheel';
interface Props { items?: WheelItem[]; label?: string; decorative?: boolean; size?: string }
const { items = [], label = '', decorative = false, size = 'min(78vh, 56vw, 760px)' } = Astro.props;
const rays = buildRays(items);
const discs = hubDiscs();
const LIFT = 26; // outward movement on hover (viewBox units)
const ELBOW_R = 478; // leader line leaves the wheel radially to this radius, then runs horizontally
const px = (n: number) => `${Math.round(n * 10) / 10}px`;
---
<div class="wheel-stage" data-wheel style={`--ws:${size}`}>
  <svg class="wheel" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg"
       role={decorative ? undefined : 'group'} aria-label={decorative ? undefined : label} aria-hidden={decorative ? 'true' : undefined}>
    <g class="spin">
      {rays.map((r) => {
        const base = [CENTER + r.dir[0] * R_START, CENTER + r.dir[1] * R_START];
        const fromEdge = r.index % 2 === 0; // even pieces are drawn at the edges of the site, odd ones at the centre of the star
        const sx = fromEdge ? 1250 : -280;
        const vars = `--x0:${px(r.dir[0] * sx)};--y0:${px(r.dir[1] * sx)};--dx:${px(r.dir[0] * LIFT)};--dy:${px(r.dir[1] * LIFT)};--bx:${px(-r.dir[0] * 150)};--by:${px(-r.dir[1] * 150)};--ox:${px(base[0])};--oy:${px(base[1])};--i:${r.index}`;
        if (r.item && !decorative) {
          const ex = CENTER + r.dir[0] * ELBOW_R, ey = CENTER + r.dir[1] * ELBOW_R;
          const side = r.dir[0] < 0 ? 'l' : 'r';
          return (
            <a href={r.item.href} class="ray ray--item" data-angle={r.angle} data-label={r.item.label} data-desc={r.item.description ?? ''}
               data-tx={r.tip[0] + r.dir[0] * LIFT} data-ty={r.tip[1] + r.dir[1] * LIFT} data-ex={ex} data-ey={ey} data-side={side}
               aria-label={r.item.description ? `${r.item.label} — ${r.item.description}` : r.item.label} style={vars}>
              <polygon class="halo-a" points={r.points} />
              <polygon class="halo-b" points={r.points} />
              <g class="shape"><polygon class="ring" points={r.outline} /><polygon class={`vis fill-${r.fill}`} points={r.points} pathLength="1" /></g>
              <polygon class="hit" points={r.points} />
            </a>
          );
        }
        return (
          <g class="ray ray--deco" aria-hidden="true" style={vars}>
            <g class="shape"><polygon class="ring" points={r.outline} /><polygon class={`vis fill-${r.fill}`} points={r.points} pathLength="1" /></g>
          </g>
        );
      })}
    </g>
    <polyline class="leader" points="" fill="none" aria-hidden="true" />
    <g class="hub" aria-hidden="true">
      {discs.map((h, k) => (
        <g class="rg" style={`--t:${(5.5 + k * 1.7).toFixed(1)}s;--dir:${k % 2 ? 'reverse' : 'normal'}`}>
          <circle class="ring" cx={h.ox} cy={h.oy} r={h.inkR} />
          <circle cx={h.cx} cy={h.cy} r={h.r} class={`fill-${h.fill}`} pathLength="1" style={`--j:${k}`} />
        </g>
      ))}
    </g>
    {!decorative && <circle class="hub-hit" cx={CENTER} cy={CENTER} r="132" aria-hidden="true" />}
  </svg>
  {!decorative && (
    <div class="cap" data-side="r" aria-hidden="true" hidden>
      <strong class="cap__name"></strong>
      <span class="cap__desc"></span>
    </div>
  )}
</div>

<script>
  import { initWheel } from '../scripts/wheel';
  document.querySelectorAll<HTMLElement>('[data-wheel]').forEach(initWheel);
</script>

<style is:global>
  .wheel-stage { position: relative; width: var(--ws); margin-inline: auto; }
  .wheel { display: block; width: 100%; height: auto; overflow: visible; }
  /* outlines are variable-width ink shapes (.ring), not strokes */
  .wheel .vis, .wheel circle { stroke: none; }
  .wheel .ring { fill: var(--brown); stroke: none; }
  .wheel .fill-mustard { --f: var(--mustard); }
  .wheel .fill-coral { --f: var(--coral); }
  .wheel .fill-ochre { --f: var(--ochre); }
  .wheel .fill-cream { --f: var(--cream); }
  .wheel .fill-brown { --f: var(--brown); }
  .wheel .vis, .wheel circle:not(.ring):not(.hub-hit) { fill: var(--f); transition: fill .22s ease; }

  .wheel .spin { transform-origin: 500px 500px; }
  .wheel .shape { transform-origin: var(--ox) var(--oy); transition: transform .26s cubic-bezier(.3, 1.4, .5, 1), opacity .26s ease; }
  .wheel .ray--item { cursor: pointer; outline: none; }
  .wheel .hit { fill: transparent; stroke: transparent; stroke-width: 10; stroke-linejoin: round; }
  .wheel .halo-a, .wheel .halo-b { display: none; fill: none; stroke-linejoin: round; transition: transform .26s cubic-bezier(.3, 1.4, .5, 1); transform-origin: var(--ox) var(--oy); }
  .wheel .halo-a { stroke: var(--brown); stroke-width: 26; }
  .wheel .halo-b { stroke: var(--cream); stroke-width: 15; }

  /* active ray: moves outward and grows slightly; the others recede toward the paper colour */
  .wheel .ray.is-active .shape, .wheel .ray.is-active .halo-a, .wheel .ray.is-active .halo-b { transform: translate(var(--dx), var(--dy)) scale(1.07); }
  .wheel[data-active] .ray:not(.is-active) .vis { fill: color-mix(in srgb, var(--f) 38%, var(--cream)); }
  .wheel[data-active] .hub circle:not(.ring) { fill: color-mix(in srgb, var(--f) 55%, var(--cream)); }
  .wheel .ray--item:focus-visible .halo-a, .wheel .ray--item:focus-visible .halo-b { display: block; }

  /* hovering the centre of the star: the hub's rings turn against each other (the thick side of every ink ring travels),
     the hub swells a little and the rays lean outward. A ripple leaves the centre (wheel.ts). */
  .wheel .rg { transform-origin: 500px 500px; }
  .wheel .hub-hit { fill: transparent; stroke: none; pointer-events: all; }
  .wheel .hub { transform-origin: 500px 500px; transition: transform .35s cubic-bezier(.3, 1.4, .5, 1); }
  @media (prefers-reduced-motion: no-preference) {
    .wheel:has(.hub-hit:hover) .rg { animation: hub-spin var(--t, 6s) linear infinite; animation-direction: var(--dir, normal); }
    .wheel:has(.hub-hit:hover) .hub { transform: scale(1.07); }
    .wheel:has(.hub-hit:hover) .shape { transform: translate(calc(var(--dx) * .35), calc(var(--dy) * .35)); }
  }
  @keyframes hub-spin { to { rotate: 360deg; } }
  /* "press me" hint: an item ray twitches outward and settles (individual properties, so hover still works) */
  .wheel .ray--item.nudge .shape { animation: ray-nudge 1s cubic-bezier(.3, 1.3, .5, 1); }
  @keyframes ray-nudge {
    0%, 100% { translate: 0 0; scale: 1; }
    22% { translate: calc(var(--dx) * .7) calc(var(--dy) * .7); scale: 1.045; }
    42% { translate: calc(var(--dx) * .1) calc(var(--dy) * .1); scale: 1; }
    60% { translate: calc(var(--dx) * .38) calc(var(--dy) * .38); scale: 1.02; }
    80% { translate: 0 0; scale: 1; }
  }
  .wheel .leader { stroke: var(--brown); stroke-width: 4; stroke-linejoin: miter; opacity: 0; transition: opacity .2s ease; pointer-events: none; }
  .wheel[data-active] .leader { opacity: 1; }
  .wheel.is-busy { pointer-events: none; }
  .wheel.is-busy .leader { opacity: 0; }
  .wheel .spin.is-turning { transition: transform .75s cubic-bezier(.55, 0, .15, 1); }

  .cap { position: absolute; width: max-content; max-width: calc((100vw - var(--ws)) / 2 - 2.5rem); pointer-events: none; transform: translateY(-50%); }
  .cap[data-side='l'] { right: calc(100% + 1.4rem); text-align: right; }
  .cap[data-side='r'] { left: calc(100% + 1.4rem); text-align: left; }
  .cap__name { display: block; font-size: clamp(1.8rem, 3vw, 2.8rem); font-weight: 500; line-height: 1; margin-bottom: .4em; overflow-wrap: anywhere; }
  .cap__desc { display: block; font-size: 1rem; line-height: 1.4; }

  /* leaving: everything but the chosen ray retracts into the hub */
  .wheel.is-leaving .ray:not(.is-active) .shape { transform: translate(var(--bx), var(--by)) scale(.25); opacity: 0; transition: transform .34s cubic-bezier(.5, 0, .9, .4), opacity .3s ease; }
  .wheel.is-leaving .hub { transform: scale(1.06); transform-origin: 500px 500px; transition: transform .34s ease; }

  /* returning from an app page: the wheel rebuilds from the hub, ray by ray */
  @media (prefers-reduced-motion: no-preference) {
    .rebuild .wheel .shape { animation: ray-in .6s cubic-bezier(.2, .9, .3, 1.15) backwards; animation-delay: calc(var(--i, 0) * 45ms + 60ms); }
    .rebuild .wheel .hub { animation: hub-in .5s ease backwards; transform-origin: 500px 500px; }
  }
  @keyframes ray-in { from { transform: translate(var(--bx), var(--by)) scale(.2); opacity: 0; } }
  @keyframes hub-in { from { transform: scale(.7); opacity: 0; } }

  /* idle: after the intro the wheel barely breathes and hovers (one transform animation, GPU only) */
  .desk .wheel-stage::after { content: ''; position: absolute; left: 22%; right: 22%; bottom: -2%; height: 4.5%; border-radius: 50%; background: var(--brown); opacity: 0; pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    html:not(.intro-run) .desk .wheel { will-change: transform; animation: breathe 8s ease-in-out infinite, sway 19s ease-in-out infinite; }
    html:not(.intro-run) .desk .wheel.is-busy { animation-play-state: paused; }
    html:not(.intro-run) .desk .wheel-stage::after { animation: breathe-shadow 8s ease-in-out infinite; }
  }
  /* breathing + hovering (translate/scale) and a faint turn clockwise, then counter-clockwise (rotate) */
  @keyframes breathe {
    0%, 100% { translate: 0 0; scale: 1; }
    50% { translate: 0 -9px; scale: 1.016; }
  }
  @keyframes sway {
    0%, 100% { rotate: 0deg; }
    25% { rotate: 3.5deg; }
    75% { rotate: -3.5deg; }
  }
  @keyframes breathe-shadow {
    0%, 100% { opacity: .05; transform: scaleX(1); }
    50% { opacity: .025; transform: scaleX(.88); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel .shape, .wheel .halo-a, .wheel .halo-b, .wheel .vis, .wheel circle { transition: none; }
  }
</style>
